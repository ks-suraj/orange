# --- LLM provider -----------------------------------------------------------
# Only "openrouter" is implemented (OpenAI-compatible chat completions API).
LLM_PROVIDER=openrouter
# Any OpenRouter model id. Default: cheapest current Claude model.
# Upgrade path if reasoning quality is insufficient: anthropic/claude-sonnet-5.5
LLM_MODEL=anthropic/claude-haiku-5.5
# An OpenRouter *inference* API key (a management/provisioning key will be rejected).
OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Reasoning effort passed to the provider: low | medium | high | none
LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT_S=120
# LLM_MAX_RETRIES=3
# Provider-side JSON-schema constrained output for tool-less agent calls (falls back automatically if rejected)
# LLM_STRUCTURED_OUTPUTS=true

# --- Investigation limits (shared by the multi-agent system and the baseline) ---
# INV_MAX_ROUNDS=3
# INV_MAX_TASKS_PER_ROUND=4
# INV_MAX_TOOL_CALLS_PER_TASK=6
# INV_MAX_TOTAL_TOOL_CALLS=30
# INV_MAX_TOOL_RETRIES=2
# INV_MAX_TASK_ATTEMPTS=2
# INV_MAX_REPAIR_ATTEMPTS=2
# INV_PARALLEL_WORKERS=4
# INV_INCONCLUSIVE_THRESHOLD=0.5
# INV_MIN_SUPPORTING_EVIDENCE=2
# INV_MIN_CONFIDENCE_MARGIN=0.05
# Inconclusive when contradicting evidence (hypothesis + material critic objections) exceeds this share
# INV_MAX_CONTRADICTION_SHARE=0.35
# INV_MAX_REPORTED_GAPS=10
